.env
.env.*
*.pem
*.key
*token*
.dev.vars
.wrangler/

# Editor and OS clutter
.DS_Store
.vscode/
.idea/
__pycache__/
dist-repro/
dist-tracking/

# The owner's FULL facts file (internal notes, open questions, staff names) never goes in this public repo.
# Only its generated public subset does: facts/facts.public.json (scripts/make-public-facts.mjs).
facts/facts.json
