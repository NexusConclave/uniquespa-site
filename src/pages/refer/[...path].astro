---
/**
 * /refer (blueprint §4.7, §8.4; compliance G5: §17500 condition named, §650 no rewards on medical items).
 * BUILT BUT NOT LINKED: nothing links here until site.flags.refer_live is on (owner's yes, P0 question 5).
 * The page is GENERATED only when offers.json "referral-25" is approved OR the build has PREVIEW=1; otherwise
 * getStaticPaths returns nothing and /refer is a plain 404. Noindex like every staging page (BaseLayout).
 * Never promoted in the review request (§7.2, 16 CFR 465). Uni never texts the friend; the share box only builds
 * a message the client copies or shares themselves. Staff log the credit in a Square customer field.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Icon from '../../components/Icon.astro';
import { offerById, isDraft } from '../../lib/offers';
import { site, SITE_URL } from '../../lib/site';

export function getStaticPaths() {
  return offerById('referral-25') ? [{ params: { path: undefined } }] : [];
}

const referral = offerById('referral-25')!;
const shareUrl = `${SITE_URL}/?utm_source=referral&utm_medium=share&utm_campaign=refer-a-friend`;
const steps = [
  { t: 'Share', d: 'Send a friend who has never been to either spa a note with our link. The box below writes it for you.' },
  { t: 'They book', d: 'Your friend books their first visit and adds the note "Referred by" and your name.' },
  { t: 'Your thank-you', d: 'After their paid visit, you get $25 off a spa service of $150 or more. Use it within 90 days.' },
];
---
<BaseLayout
  title="Refer a Friend | Unique Spa House"
  description="Refer a friend to Unique Spa House. After their first paid visit, you get $25 off a spa service of $150 or more."
>
  <Section class="rf-hero" pad="tight" reveal={false}>
    <p class="eyebrow">Refer a friend</p>
    <h1 class="rf-hero__h1">Share the <em>calm</em></h1>
    <p class="lede rf-hero__lede">Know someone who could use a good massage or facial? Send them our way. After their first paid visit, you get $25 off your next spa service of $150 or more.</p>
    {isDraft(referral) && <p class="draft-note">Draft offer — needs owner approval</p>}
  </Section>

  <Section labelledby="rf-how-title" class="rf-how" pad="tight">
    <h2 id="rf-how-title" class="sr-only">How it works</h2>
    <ol class="rf-steps" role="list">
      {steps.map((s, i) => (
        <li class="rf-step">
          <span class="rf-step__n" aria-hidden="true">{i + 1}</span>
          <h3><span class="sr-only">Step {i + 1}: </span>{s.t}</h3>
          <p>{s.d}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section tone="paper" labelledby="rf-share-title" class="rf-share">
    <div class="rf-share__grid" data-refer data-url={shareUrl}>
      <div class="rf-share__intro">
        <h2 id="rf-share-title">Write your <em>note</em></h2>
        <p>Add your first name and we'll write a short message with our link. Copy it, or share it straight from your phone. We never contact your friend for you.</p>
      </div>
      <div class="rf-box">
        <div class="rf-field">
          <label for="rf-name">Your first name</label>
          <input id="rf-name" type="text" autocomplete="given-name" maxlength="40" data-refer-name />
        </div>
        <div class="rf-field">
          <label for="rf-msg">Your message</label>
          <textarea id="rf-msg" rows="7" data-refer-msg aria-describedby="rf-msg-help"></textarea>
          <p class="rf-help" id="rf-msg-help">You can edit it before you send it.</p>
        </div>
        <div class="rf-actions">
          <button type="button" class="btn btn--outline" data-refer-copy><Icon name="copy" />Copy message</button>
          <button type="button" class="btn btn--outline" data-refer-share hidden><Icon name="share" />Share</button>
        </div>
        <p class="rf-status" role="status" aria-live="polite" data-refer-status></p>
      </div>
    </div>
  </Section>

  <Section labelledby="rf-terms-title" class="rf-terms">
    <h2 id="rf-terms-title">The fine print</h2>
    <ul class="rf-terms__list">
      <li>For new clients only: your friend must be new to both spas.</li>
      <li>Your friend books a first visit with the note "Referred by" and your name. We check bookings the day before.</li>
      <li>Your $25 off is for one spa service of $150 or more (massage, facials and body treatments), used within 90 days of your friend's paid visit.</li>
      <li>One offer per visit. The credit can't be used on top of a special or another discount, and has no cash value.</li>
      <li>Up to 5 referral credits a year. We note each one on your client record.</li>
    </ul>
    <p class="rf-terms__q">Questions? Call or text <a href={site.phone.tel} data-track="call_click" data-track-props='{"placement":"refer"}'>{site.phone.display}</a>.</p>
  </Section>
</BaseLayout>

<script>
  function message(name: string, url: string): string {
    const who = name.trim() || '[your name]';
    return `I go to Unique Spa House for massage and facials, in San Diego (Mission Valley) and Del Mar. If you book a first visit, add the note "Referred by ${who}" so they know I sent you: ${url}`;
  }
  function init() {
    const root = document.querySelector<HTMLElement>('[data-refer]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const url = root.dataset.url || location.origin;
    const nameEl = root.querySelector<HTMLInputElement>('[data-refer-name]')!;
    const msgEl = root.querySelector<HTMLTextAreaElement>('[data-refer-msg]')!;
    const status = root.querySelector<HTMLElement>('[data-refer-status]')!;
    const shareBtn = root.querySelector<HTMLButtonElement>('[data-refer-share]')!;
    let edited = false;
    msgEl.value = message('', url);
    nameEl.addEventListener('input', () => { if (!edited) msgEl.value = message(nameEl.value, url); status.textContent = ''; });
    msgEl.addEventListener('input', () => { edited = true; });
    root.querySelector<HTMLButtonElement>('[data-refer-copy]')!.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(msgEl.value);
        status.textContent = 'Copied. Paste it into a text or email to your friend.';
      } catch {
        msgEl.focus(); msgEl.select();
        status.textContent = 'Select the message and copy it.';
      }
    });
    if (typeof navigator.share === 'function') {
      shareBtn.hidden = false;
      shareBtn.addEventListener('click', async () => {
        try { await navigator.share({ text: msgEl.value }); } catch { /* cancelled */ }
      });
    }
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .rf-hero__h1 { font-size: clamp(3rem, 1.8rem + 5vw, 6rem); }
  .rf-hero__lede { margin-top: 1.25rem; }

  .rf-steps { display: grid; gap: 0; margin: 0; padding: 0; }
  @media (min-width: 800px) { .rf-steps { grid-template-columns: repeat(3, 1fr); column-gap: 2.5rem; } }
  .rf-step { display: grid; gap: 0.5rem; padding-block: 1.5rem; border-top: 1px solid var(--text); align-content: start; max-width: none; }
  .rf-step__n { font-family: var(--font-serif); font-size: clamp(3rem, 2.4rem + 2vw, 4.5rem); line-height: 1; color: var(--text-soft-lg); }
  .rf-step h3 { font-size: 1.6rem; }

  .rf-share__grid { display: grid; gap: clamp(1.5rem, 5vw, 5rem); }
  @media (min-width: 960px) { .rf-share__grid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); } }
  .rf-share__intro { display: flex; flex-direction: column; gap: 1rem; }
  .rf-box { display: flex; flex-direction: column; gap: 1.25rem; max-width: 38rem; }
  .rf-field { display: flex; flex-direction: column; gap: 0.4rem; }
  .rf-field label { font-size: var(--fs-label); font-weight: 500; font-stretch: var(--wdth-label); }
  .rf-field input, .rf-field textarea {
    width: 100%; min-height: 48px; padding: 0.65rem 0.9rem;
    background: var(--bg); border: 1px solid var(--border-ui); border-radius: 8px; font-size: var(--fs-body); line-height: 1.45;
  }
  .rf-field textarea { resize: vertical; overflow-wrap: anywhere; }
  .rf-help { font-size: var(--fs-meta); color: var(--text-muted); }
  .rf-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .rf-status:empty { display: none; }
  .rf-status { font-size: var(--fs-label); font-weight: 500; }

  .rf-terms__list { margin: 1.25rem 0 0; padding-left: 1.2rem; display: grid; gap: 0.6rem; max-width: 46rem; }
  .rf-terms__list li::marker { color: var(--text-muted); }
  .rf-terms__q { margin-top: 1.25rem; }
</style>
