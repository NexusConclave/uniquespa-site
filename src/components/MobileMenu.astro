---
/**
 * MobileMenu — a modal <dialog> opened by the header's Menu button (<1024px).
 * Holds Book, Call, Text us and Ask Uni first, then the nav (Treatments, Our spas, Offers shown EXPANDED, About, Contact)
 * and the Pause motion toggle. Esc closes; focus returns to the Menu button (site.ts).
 */
import { TREATMENTS, SPAS_LINKS, offerLinks, isCurrent } from '../lib/nav';
import { site } from '../lib/site';
import LotusMark from './LotusMark.astro';
import Icon from './Icon.astro';
import MotionToggle from './MotionToggle.astro';
const path = Astro.url.pathname;
const groups = [
  { title: 'Treatments', links: TREATMENTS },
  { title: 'Our spas', links: SPAS_LINKS },
  { title: 'Offers', links: offerLinks() },
];
---
<dialog id="mobile-menu" class="mm" aria-labelledby="mm-title">
  <div class="mm__top">
    <a class="mm__brand" href="/"><LotusMark size={26} /><span>Unique Spa House</span></a>
    <button type="button" class="mm__close" data-close aria-label="Close menu"><Icon name="close" /></button>
  </div>
  <h2 id="mm-title" class="sr-only">Menu</h2>
  <div class="mm__actions">
    <a class="btn btn--filled btn--block" href="/menu" data-open="book" aria-haspopup="dialog" data-track="book_click" data-track-props='{"placement":"menu"}'>Book a visit</a>
    <div class="mm__row">
      <a class="btn btn--outline" href={site.phone.tel} data-track="call_click" data-track-props='{"placement":"menu"}'><Icon name="phone" />Call</a>
      <a class="btn btn--outline" href={site.sms} data-track="text_click" data-track-props='{"placement":"menu"}'><Icon name="message" />Text us</a>
      <button type="button" class="btn btn--outline" data-open="uni" aria-haspopup="dialog" data-track="chat_open" data-track-props='{"placement":"menu"}'>Ask Uni</button>
    </div>
    <p class="meta">{site.phone.display} · both spas</p>
  </div>
  <nav aria-label="Main" class="mm__nav">
    {groups.map((g) => (
      <section class="mm__group" aria-label={g.title}>
        <p class="mm__heading label" aria-hidden="true">{g.title}</p>
        <ul role="list">
          {g.links.map((l) => <li><a href={l.href} aria-current={isCurrent(path, l.href) ? 'page' : undefined}>{l.label}</a></li>)}
        </ul>
      </section>
    ))}
    <ul role="list" class="mm__more">
      <li><a href="/about" aria-current={isCurrent(path, '/about') ? 'page' : undefined}>About</a></li>
      <li><a href="/contact" aria-current={isCurrent(path, '/contact') ? 'page' : undefined}>Contact</a></li>
    </ul>
  </nav>
  <div class="mm__foot"><MotionToggle /></div>
</dialog>

<style>
  .mm {
    width: 100%; max-width: 100%; height: 100%; max-height: 100%;
    margin: 0; padding: 0 var(--gutter) calc(1.5rem + env(safe-area-inset-bottom, 0px));
    border: 0;
    background-color: var(--bg); background-image: var(--grain);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .mm[open] { display: flex; flex-direction: column; animation: mm-in 0.28s var(--ease); }
  @keyframes mm-in { from { opacity: 0; transform: translateY(8px); } }
  .mm::backdrop { background: rgba(52, 18, 4, 0.35); }
  .mm__top { display: flex; align-items: center; justify-content: space-between; min-height: 64px; position: sticky; top: 0; background: inherit; z-index: 1; }
  .mm__brand { display: inline-flex; align-items: center; gap: 0.55rem; min-height: var(--tap); text-decoration: none; font-family: var(--font-serif); font-size: 1.4rem; }
  .mm__close { display: grid; place-items: center; width: var(--tap); height: var(--tap); border: 1px solid var(--border-ui); border-radius: 50%; background: transparent; }
  .mm__close :global(svg) { width: 20px; height: 20px; }
  .mm__nav { display: grid; gap: 1.5rem; padding-block: 1rem 2rem; }
  .mm__heading { margin-bottom: 0.25rem; }
  .mm__nav ul { margin: 0; padding: 0; list-style: none; }
  .mm__nav a {
    display: flex; align-items: center; min-height: 48px;
    font-family: var(--font-serif); font-size: 1.85rem; line-height: 1.1;
    text-decoration: none;
  }
  .mm__nav a[aria-current='page'] { text-decoration: underline; text-underline-offset: 0.18em; text-decoration-thickness: 1px; }
  .mm__more { border-top: 1px solid var(--hairline); padding-top: 1rem !important; }
  /* Book, Call, Text and Uni first, so they're on the first screen (QA m-18) */
  .mm__actions { display: grid; gap: 0.75rem; padding-block: 0.5rem 1.25rem; border-bottom: 1px solid var(--hairline); }
  .mm__foot { margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--hairline); }
  .mm__row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
  .mm__row .btn { --btn-pad: 0.5rem; }
</style>
