---
/**
 * Inline line icons (stroke = currentColor). Decorative by default (aria-hidden).
 * Map pin follows Phosphor Light's shape. Add `label` only when the icon carries meaning on its own.
 */
export type IconName =
  | 'chevron-down' | 'arrow-right' | 'arrow-up-right' | 'phone' | 'message' | 'pin' | 'close' | 'menu'
  | 'gift' | 'calendar' | 'clock' | 'pause' | 'play' | 'instagram' | 'facebook' | 'check' | 'alert' | 'mail' | 'copy' | 'share';
interface Props { name: IconName; size?: number | string; label?: string; class?: string }
const { name, size = '1em', label, class: cls } = Astro.props;
const paths: Record<IconName, string> = {
  'chevron-down': '<path d="M6 9.5l6 6 6-6"/>',
  'arrow-right': '<path d="M4 12h15M13 6l6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17L17 7M8.5 7H17v8.5"/>',
  phone: '<path d="M8.6 3.8 6.5 3.5c-1 0-2.9 1.4-2.9 3.3 0 6.9 6.7 13.6 13.6 13.6 1.9 0 3.3-1.9 3.3-2.9l-.3-2.1-3.9-1.6-1.9 2c-2.4-1.1-4.4-3.1-5.5-5.5l2-1.9z"/>',
  message: '<path d="M20.5 12a8.5 8.5 0 0 1-12.4 7.5L3.5 20.5l1.1-4.4A8.5 8.5 0 1 1 20.5 12z"/>',
  pin: '<path d="M19.5 9.75c0 6.75-7.5 12-7.5 12s-7.5-5.25-7.5-12a7.5 7.5 0 0 1 15 0z"/><circle cx="12" cy="9.75" r="3"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  menu: '<path d="M4 9h16M4 15h16"/>',
  gift: '<rect x="3.5" y="8.5" width="17" height="4" rx=".5"/><path d="M5 12.5v7.5h14v-7.5M12 8.5v11.5M12 8.5S10.6 4 8.2 4.4C6.6 4.7 6.7 7.2 8.6 8.5M12 8.5s1.4-4.5 3.8-4.1c1.6.3 1.5 2.8-.4 4.1"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15.5" rx="1.5"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  pause: '<path d="M9 6v12M15 6v12"/>',
  play: '<path d="M8 5.5v13l10-6.5z"/>',
  instagram: '<rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6" fill="currentColor"/>',
  facebook: '<path d="M14.5 8.5H17V5h-2.5C12 5 10.5 6.6 10.5 9v2H8v3.5h2.5V21H14v-6.5h2.6l.4-3.5h-3V9.3c0-.5.3-.8.5-.8z"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  alert: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5v5.5"/><circle cx="12" cy="16.25" r=".6" fill="currentColor"/>',
  mail: '<rect x="3.5" y="5.5" width="17" height="13" rx="1.5"/><path d="M4 6.5l8 6.5 8-6.5"/>',
  copy: '<rect x="8.5" y="8.5" width="11" height="11" rx="1.5"/><path d="M15.5 8.5V6A1.5 1.5 0 0 0 14 4.5H6A1.5 1.5 0 0 0 4.5 6v8A1.5 1.5 0 0 0 6 15.5h2.5"/>',
  share: '<path d="M12 14.5V3.5M8 7.5l4-4 4 4M7 10.5H5.5v10h13v-10H17"/>',
};
---
<svg
  class:list={['icon', cls]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={paths[name]}
/>
