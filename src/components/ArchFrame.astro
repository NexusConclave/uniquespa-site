---
/**
 * ArchFrame — the static arch (§5.3): round top whose radius is half the frame's width, built as
 * `clip-path: inset(0 round 50cqi 50cqi 0 0)` (cqi = 1% of this frame's width, so it stays a true
 * semicircle at any size). For people and the two spas only. One arch moment in view at a time.
 * The animated variant lives in DoorStage.astro (Home only).
 */
import { Picture } from 'astro:assets';
import { asset as getAsset, widthsFor, objectPosition, type Asset } from '../lib/images';
interface Props {
  asset: string | Asset;
  ratio?: string;          // CSS aspect-ratio of the frame, e.g. "4 / 5"
  sizes?: string;
  alt?: string;            // overrides the manifest alt
  loading?: 'lazy' | 'eager';
  class?: string;
  parallax?: boolean;      // gentle scroll drift (styles/motion.css)
}
const { asset: a, ratio = '4 / 5', sizes = '(min-width: 1024px) 40vw, 90vw', alt, loading = 'lazy', class: cls, parallax = false } = Astro.props;
const img = typeof a === 'string' ? getAsset(a) : a;
---
<figure class:list={['arch', cls]} style={`--arch-ratio: ${ratio}; --pos: ${objectPosition(img)}`} data-parallax={parallax ? '' : undefined}>
  <Picture
    src={img.src}
    formats={['avif', 'webp']}
    widths={widthsFor(img.src)}
    sizes={sizes}
    quality={62}
    alt={alt ?? img.alt}
    loading={loading}
    decoding="async"
  />
</figure>
<style>
  .arch {
    container-type: inline-size;
    position: relative;
    aspect-ratio: var(--arch-ratio);
    margin: 0;
  }
  .arch :global(picture), .arch :global(img) {
    width: 100%;
    height: 100%;
  }
  .arch :global(img) {
    object-fit: cover;
    object-position: var(--pos, 50% 50%);
    clip-path: inset(0 round 50cqi 50cqi 0 0);
    background: var(--sand);
  }
</style>
