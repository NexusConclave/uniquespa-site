# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# integrations/postbuild.mjs finishes this file in dist/:
#   - the INLINE_SCRIPT_HASHES placeholder in the CSP becomes the sha256 of every inline <script> the build emits (so no 'unsafe-inline').
#   - staging builds (site.json "launch": false) add "X-Robots-Tag: noindex, nofollow" to every response.
# CSP allows: our own files; Square booking/gift links (plain links and new tabs, so no CSP entry needed);
# Uni voice (ElevenLabs api over https/wss; its audio worklets and the optional resampler worklet are self-hosted in
# /chat/worklets, so script-src needs no blob: and no CDN); Cloudflare Web Analytics (beacon script + report endpoint); Cloudflare Turnstile for
# /api/lead (script, iframe and API on challenges.cloudflare.com; only loaded when PUBLIC_TURNSTILE_SITE_KEY is set).

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' {{INLINE_SCRIPT_HASHES}} https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://*.elevenlabs.io wss://*.elevenlabs.io https://cloudflareinsights.com https://static.cloudflareinsights.com https://challenges.cloudflare.com; media-src 'self' blob: data:; worker-src 'self'; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(self), camera=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Build-hashed assets never change: cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=2592000

# The plain-text brief for AI assistants (src/pages/llms.txt.ts): UTF-8, so en dashes and "·" survive.
/llms.txt
  Content-Type: text/plain; charset=utf-8

# Previews and the raw project address are never indexed, even after launch (only uniquespahouse.com is).
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow
